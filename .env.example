# HealthTrack Configuration
PROJECT_NAME="HealthTrack Follow-Up System"
CLINIC_NAME="HealthTrack Clinic"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
DATABASE_URL="sqlite:///./healthtrack.db"

# LLM Provider Configuration
# Supported options:
#   "openrouter"                       - OpenRouter primary only, followed by deterministic fallback on failure
#   "gemini"                           - Google Gemini primary only, followed by deterministic fallback on failure
#   "openrouter_with_gemini_fallback"  - OpenRouter primary, with Google Gemini backup failover, then deterministic fallback
#   "none"                             - Run completely offline using deterministic templates (default)
LLM_PROVIDER="openrouter"

# OpenRouter Configuration (Primary Free Provider)
# STRICT ZERO-COST POLICY: OpenRouter model MUST contain the ':free' suffix.
# Browse currently active free models at: https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY="replace_with_your_own_openrouter_key"
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SITE_URL=""
OPENROUTER_APP_NAME="HealthTrack"

# Google Gemini Configuration (Optional Secondary Backup Provider)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.6-flash"

# Global LLM Request Timeout (seconds)
LLM_TIMEOUT_SECONDS=15.0
