# HealthTrack Configuration
PROJECT_NAME="HealthTrack Follow-Up System"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
DATABASE_URL="sqlite:///./healthtrack.db"

# LLM Provider Configuration
# Set LLM_PROVIDER="gemini" to enable Google Gemini personalization.
# Set LLM_PROVIDER="none" (default) to run completely offline with deterministic templates.
LLM_PROVIDER="none"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash"
LLM_TIMEOUT_SECONDS=10.0
